# SearchAPI.io API Key - get yours at https://www.searchapi.io/
SEARCHAPI_API_KEY=

# SearchAPI.io API Base URL
SEARCHAPI_BASE_URL=https://www.searchapi.io/api/v1/search

# Optional: OpenAI API Key for AI Executive Summary generation
# If not provided, a rule-based summary will be generated instead
OPENAI_API_KEY=

# Optional: Model to use for AI summary (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Number of search results to return per query (default: 10)
SEARCH_NUM=10

# Path to the signal keywords JSON config file (optional, defaults to config/signal_keywords.json)
SIGNAL_KEYWORDS_PATH=